# ==============================================================================
# AETHER Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure online AI research capabilities.
# Note: AETHER functions 100% offline without any API keys or network connection!
# If GEMINI_API_KEY is not set, AETHER automatically falls back to its built-in
# domain synthesis engine for custom kit generation.
# ==============================================================================

# Google Gemini API Key for Online Research and Synthesis (Optional)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Server Port (Default: 3000)
PORT=3000

# Application Environment
NODE_ENV=development
